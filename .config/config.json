{
  // Built-in defaults. A user file (`config.json5`, `config.json`,
  // `config.yaml`, `config.toml` or `config.ini` in the config directory,
  // `$QRY_CONFIG` or `~/.config/qry/` on Linux) is layered on top of them;
  // `qry --print-config` prints the result.
  "theme": "dark",

  // Run all (F8) stops at the first statement that fails, unless this is
  // true.
  "continue_on_error": false,

  // The query history (ctrl-r in the editor): every statement sent, per
  // connection, in `<data dir>/history/<connection id>.jsonl`. The scratch
  // database's stays in memory unless `ephemeral_to_disk` is true. A string
  // literal after one of the `redact` words is stored as '•••'.
  "history": {
    "enabled": true,
    "max_entries": 1000,
    "ephemeral_to_disk": false,
    "redact": ["PASSWORD", "IDENTIFIED BY", "SECRET"]
  },

  // Key bindings, by context: `Global` applies wherever a pane has focus,
  // under the focused pane's own (`Tree`, `Editor`, `Results`, `Inspector`,
  // `Jobs`), which win over it. `Dialog`, `Help` and `Palette` apply alone
  // while one of those is open. Values are action names
  // (crates/qry/src/action.rs).
  //
  // Keys (crates/qry/src/keymap.rs): `<ctrl-q>`, `<shift-tab>`, `<f5>`; a
  // sequence is `<g><g>`. A single character keeps its case (`<G>` is
  // shift-g); modifiers and named keys are case-insensitive. A user entry
  // replaces the default for that key, and `null` unbinds it.
  "keybindings": {
    "Global": {
      "<ctrl-q>": "Quit",
      "<f1>": "Help",
      "<ctrl-p>": "Palette",
      "<tab>": "FocusNext",
      "<shift-tab>": "FocusPrev",
      "<ctrl-n>": "NewConnection",
      "<ctrl-o>": "ImportConnections",
      "<ctrl-1>": { "SwitchSession": 1 },
      "<ctrl-2>": { "SwitchSession": 2 },
      "<ctrl-3>": { "SwitchSession": 3 },
      "<ctrl-4>": { "SwitchSession": 4 },
      "<ctrl-5>": { "SwitchSession": 5 },
      "<ctrl-6>": { "SwitchSession": 6 },
      "<ctrl-7>": { "SwitchSession": 7 },
      "<ctrl-8>": { "SwitchSession": 8 },
      "<ctrl-9>": { "SwitchSession": 9 },
      "<ctrl-pagedown>": "NextSession",
      "<ctrl-pageup>": "PrevSession",
      // The editor's own ctrl-w deletes a word instead.
      "<ctrl-w>": "CloseSession",
      "<ctrl-up>": "GrowEditor",
      "<ctrl-down>": "ShrinkEditor",
      // ctrl-z suspends, so maximising is F11.
      "<f11>": "ToggleMaximise",
      "<ctrl-/>": "ToggleHints",
      "<ctrl-l>": "ShowMessages",
      // Only when nothing else takes Esc: the panes leave it unbound.
      "<esc>": "DismissToast",
      "<ctrl-z>": "Suspend"
    },
    "Tree": {
      "<?>": "Help",
      "<:>": "Palette",
      "<j>": "Down",
      "<down>": "Down",
      "<k>": "Up",
      "<up>": "Up",
      "<h>": "Left",
      "<left>": "Left",
      "<l>": "Right",
      "<right>": "Right",
      "<g><g>": "Top",
      "<G>": "Bottom",
      "<home>": "Top",
      "<end>": "Bottom",
      "<enter>": "Open",
      "<shift-enter>": "OpenNewSession",
      "<space>": "Toggle",
      "<e>": "EditConnection",
      "<delete>": "DeleteConnection",
      "<r>": "Refresh",
      "</>": "Filter",
      "<ctrl-s>": "ExportConnections"
    },
    // `?` and `:` are not bound here, so they can be typed.
    "Editor": {
      // Terminals that cannot send ctrl-Enter have F5.
      "<ctrl-enter>": "RunStatement",
      "<f5>": "RunStatement",
      "<f8>": "RunAll",
      "<ctrl-e>": "RunSelection",
      "<ctrl-r>": "History",
      "<alt-up>": "RecallPrev",
      "<alt-down>": "RecallNext",
      "<ctrl-s>": "SaveSnippet",
      "<ctrl-c>": "CancelQuery",
      "<enter>": "NewLine",
      "<tab>": "Indent",
      // Tab and shift-Tab indent here, so F6 moves on.
      "<shift-tab>": "Dedent",
      "<f6>": "FocusNext",
      "<left>": "Left",
      "<right>": "Right",
      "<up>": "Up",
      "<down>": "Down",
      "<ctrl-left>": "WordLeft",
      "<ctrl-right>": "WordRight",
      "<home>": "LineStart",
      "<end>": "LineEnd",
      "<ctrl-home>": "Top",
      "<ctrl-end>": "Bottom",
      "<pageup>": "PageUp",
      "<pagedown>": "PageDown",
      "<shift-left>": "SelectLeft",
      "<shift-right>": "SelectRight",
      "<shift-up>": "SelectUp",
      "<shift-down>": "SelectDown",
      "<ctrl-shift-left>": "SelectWordLeft",
      "<ctrl-shift-right>": "SelectWordRight",
      "<shift-home>": "SelectLineStart",
      "<shift-end>": "SelectLineEnd",
      "<ctrl-a>": "SelectAll",
      "<backspace>": "DeleteBack",
      "<delete>": "DeleteForward",
      "<ctrl-w>": "DeleteWordBack",
      "<alt-d>": "DeleteWordForward",
      "<ctrl-k>": "DeleteToLineEnd",
      "<ctrl-x>": "Cut",
      "<ctrl-v>": "Paste",
      "<ctrl-z>": "Undo",
      "<ctrl-shift-z>": "Redo",
      "<ctrl-y>": "Redo"
    },
    "Results": {
      "<?>": "Help",
      "<:>": "Palette",
      "<j>": "Down",
      "<down>": "Down",
      "<k>": "Up",
      "<up>": "Up",
      "<h>": "Left",
      "<left>": "Left",
      "<l>": "Right",
      "<right>": "Right",
      "<g><g>": "Top",
      "<G>": "Bottom",
      "<pageup>": "PageUp",
      "<pagedown>": "PageDown",
      "<home>": "LineStart",
      "<end>": "LineEnd",
      "<ctrl-u>": "PageUp",
      "<ctrl-d>": "PageDown",
      "<0>": "LineStart",
      "<$>": "LineEnd",
      "<[>": "PrevResult",
      "<]>": "NextResult",
      "<s>": "SortColumn",
      "<S>": "AddSortColumn",
      "<n>": "NextMatch",
      "<N>": "PrevMatch",
      "<ctrl-y>": "CopyMenu",
      // `:` opens the palette, so going to a row is ctrl-g.
      "<ctrl-g>": "GotoRow",
      "<lt>": "NarrowColumn",
      "<gt>": "WidenColumn",
      "<=>": "ResetWidths",
      "<F>": "FreezeColumn",
      "<y>": "CopyCell",
      "<Y>": "CopyRow",
      "</>": "Search",
      "<i>": "ToggleInspector",
      "<enter>": "Inspect",
      "<ctrl-s>": "ExportResults"
    },
    "Inspector": {
      "<?>": "Help",
      "<:>": "Palette",
      "<j>": "Down",
      "<down>": "Down",
      "<k>": "Up",
      "<up>": "Up",
      "<h>": "Left",
      "<left>": "Left",
      "<l>": "Right",
      "<right>": "Right",
      "<g><g>": "Top",
      "<G>": "Bottom"
    },
    "Jobs": {
      "<?>": "Help",
      "<:>": "Palette",
      "<j>": "Down",
      "<down>": "Down",
      "<k>": "Up",
      "<up>": "Up",
      "<h>": "Left",
      "<left>": "Left",
      "<l>": "Right",
      "<right>": "Right",
      "<g><g>": "Top",
      "<G>": "Bottom"
    },
    // A dialog's text field types plain characters even where they are
    // bound, so Space types a space there. ctrl-p is left unbound, so it
    // goes to the field.
    "Dialog": {
      "<enter>": "Submit",
      "<esc>": "Cancel",
      "<tab>": "NextField",
      "<shift-tab>": "PrevField",
      "<left>": "Left",
      "<right>": "Right",
      "<home>": "LineStart",
      "<end>": "LineEnd",
      "<backspace>": "DeleteBack",
      "<delete>": "DeleteForward",
      "<space>": "NextChoice",
      "<f1>": "Help",
      "<ctrl-q>": "Quit"
    },
    "Help": {
      "<j>": "Down",
      "<down>": "Down",
      "<k>": "Up",
      "<up>": "Up",
      "<pageup>": "PageUp",
      "<pagedown>": "PageDown",
      "<ctrl-u>": "PageUp",
      "<ctrl-d>": "PageDown",
      "<home>": "Top",
      "<G>": "Bottom",
      "<end>": "Bottom",
      "<?>": "Help",
      "<f1>": "Help",
      "<esc>": "Cancel",
      "<ctrl-p>": "Palette",
      "<ctrl-q>": "Quit"
    },
    // Plain characters type into the query. The history dialog and the
    // snippet list use these keys too.
    "Palette": {
      "<enter>": "Submit",
      "<ctrl-enter>": "SubmitAndRun",
      "<ctrl-d>": "DeleteEntry",
      "<esc>": "Cancel",
      "<up>": "Up",
      "<down>": "Down",
      "<ctrl-k>": "Up",
      "<ctrl-j>": "Down",
      "<pageup>": "PageUp",
      "<pagedown>": "PageDown",
      "<tab>": "NextField",
      "<left>": "Left",
      "<right>": "Right",
      "<home>": "LineStart",
      "<end>": "LineEnd",
      "<backspace>": "DeleteBack",
      "<delete>": "DeleteForward",
      "<ctrl-p>": "Palette",
      "<f1>": "Help",
      "<ctrl-q>": "Quit"
    }
  }
}
